{
    "model": {
      "type": "qwen_vl_clip",
      "model_name": "qwen_vl_clip",
      "embed_dim": 768,
      "vision_encoder": {
        "model_path": "/media/ps/data-ssd/DolphinV1/dolphinV1_3B",
        "process_type": "attention_pooling",
        "vision_dim": 2048,
        "attention_heads": 8,
        "dropout": 0.1,
        "layer_norm_eps": 1e-6
      },
      "text_encoder": {
        "model_name": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/BiomedBERT/BiomedNLP-BiomedBERT-base-uncased-abstract",
        "max_length": 128,
        "dropout": 0.1
      },
      "device": "auto",
      "description": "数值稳定性优化的超声图像CLIP模型 - v6优化版本"
    },
    "training": {
      "batch_size": 16,
      "learning_rate": 5e-5,
      "weight_decay": 0.01,
      "max_epochs": 40,
      "early_stopping_patience": 8,
      "early_stopping_min_delta": 0.001,
      "gradient_clip_val": 0.5,
      "warmup_steps": 300,
      "val_check_interval": 0.25,
      "log_every_n_steps": 10,
      "save_top_k": 5,
      "monitor": "val_loss",
      "mode": "min",
      "optimizer": {
        "type": "adamw",
        "lr": 5e-5,
        "weight_decay": 0.01,
        "betas": [0.9, 0.95],
        "eps": 1e-6,
        "amsgrad": true
      },
      "scheduler": {
        "type": "cosine_with_warmup",
        "warmup_steps": 300,
        "max_steps": 8000,
        "eta_min": 5e-6,
        "warmup_init_lr": 5e-6
      },
      "loss": {
        "type": "ultrasound_finegrained",
        "temperature": 0.07,
        "margin": 0.3,
        "hard_ratio": 0.3,
        "focal_gamma": 2.0,
        "similarity_threshold": 0.75,
        "contrastive_scale": 2.0,
        "dynamic_temp_target": 0.6,
        "dynamic_temp_gain": 2.0,
        "semi_hard_window": 0.05,
        "loss_weights": {
          "clip": 1.0,
          "hard_neg": 0.5,
          "triplet": 0.3,
          "focal": 0.2
        },
        "label_smoothing": 0.1,
        "feature_clamp_range": [-5.0, 5.0],
        "temperature_range": [0.02, 0.2]
      },
      "gradient_accumulation_steps": 2,
      "mixed_precision": true,
      "find_unused_parameters": false,
      "numerical_stability": {
        "eps": 1e-6,
        "feature_enhancement_scale": 1.02,
        "gradient_clip_norm": 0.5,
        "nan_inf_detection": true,
        "safe_fallback": true
      }
    },
    "data": {
      "use_json_format": true,
      "train_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/caption_breast/改了描述字段名字/caption_breast_train.json",
      "valid_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/caption_breast/改了描述字段名字/caption_breast_valid.json",
      "test_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/caption_breast/改了描述字段名字/caption_breast_test.json",
      "image_root": "/media/ps/data/Datasets/ultrasound",
      "image_size": 384,
      "max_text_length": 128,
      "tokenizer_type": "local_bert",
      "image_normalization": "clip",
      "ultrasound_augmentation": {
        "enabled": true,
        "contrast_enhancement": true,
        "noise_reduction": true,
        "edge_enhancement": true,
        "gamma_correction": [0.8, 1.2],
        "rotation_range": [-5, 5],
        "brightness_range": [0.9, 1.1],
        "contrast_range": [0.9, 1.1],
        "elastic_deformation": false,
        "cutout_probability": 0.1,
        "mixup_alpha": 0.2,
        "cutmix_alpha": 0.1,
        "random_erasing": 0.05,
        "gaussian_blur": 0.05,
        "speckle_noise": 0.02,
        "motion_blur": 0.02
      },
      "batch_size": 16,
      "num_workers": 12,
      "pin_memory": true,
      "prefetch_factor": 4
    },
    "validation": {
      "checkpoint_every_n_epochs": 2,
      "validate_every_n_steps": 100,
      "save_best_model": true,
      "metric_for_best_model": "val_accuracy",
      "greater_is_better": true
    },
    "logging": {
      "log_level": "INFO",
      "log_nan_inf_warnings": true,
      "track_numerical_stability": true,
      "save_training_curves": true,
      "wandb_project": "ultrasound-clip-optimized",
      "experiment_name": "qwen_vl_clip_opt_v6_stable"
    },
    "version": "6.0",
    "optimizations": [
      "数值稳定性增强",
      "保守特征增强策略",
      "动态损失权重调整", 
      "早停机制优化",
      "梯度裁剪加强",
      "标签平滑正则化",
      "学习率策略优化",
      "数据增强保守化"
    ],
    "changelog": {
      "v6.0": {
        "date": "2024-current",
        "changes": [
          "降低batch_size从32到16，提高梯度更新频率",
          "提高learning_rate从1e-5到5e-5，加速收敛",
          "降低weight_decay从0.05到0.01，减少过度正则化",
          "加强gradient_clip从1.0到0.5，防止梯度爆炸",
          "优化early_stopping从15到8，减少过拟合",
          "添加label_smoothing=0.1，提升泛化能力",
          "调整损失函数权重，平衡各组件",
          "添加数值稳定性检测和处理机制",
          "保守化数据增强参数，减少训练噪声",
          "新增numerical_stability配置节"
        ]
      }
    }
  }
  