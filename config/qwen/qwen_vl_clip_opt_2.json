{
    "model": {
      "type": "qwen_vl_clip",
      "model_name": "qwen_vl_clip",
      "embed_dim": 768,
      "vision_encoder": {
        "model_path": "/media/ps/data-ssd/DolphinV1/dolphinV1_3B",
        "process_type": "default",
        "vision_dim": 2048,
        "attention_heads": 8,
        "dropout": 0.1,
        "layer_norm_eps": 1e-6
      },
      "text_encoder": {
        "model_name": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/BiomedBERT/BiomedNLP-BiomedBERT-base-uncased-abstract",
        "max_length": 128,
        "dropout": 0.1
      },
      "device": "auto",
      "description": "优化的Qwen2.5-VL CLIP模型配置，针对超声图片训练"
    },
    "training": {
      "batch_size": 16,
      "learning_rate": 1e-4,
      "weight_decay": 0.01,
      "max_epochs": 15,
      "early_stopping_patience": 12,
      "gradient_clip_val": 1.0,
      "warmup_steps": 500,
      "val_check_interval": 0.25,
      "log_every_n_steps": 20,
      "save_top_k": 3,
      "monitor": "val_loss",
      "mode": "min",
      "optimizer": {
        "type": "adamw",
        "lr": 1e-4,
        "weight_decay": 0.01,
        "betas": [0.9, 0.98],
        "eps": 1e-8
      },
      "scheduler": {
        "type": "cosine_with_warmup",
        "warmup_steps": 100,
        "max_steps": 5000,
        "eta_min": 1e-6
      },
      "loss": {
        "type": "clip",
        "temperature": 0.07,
        "label_smoothing": 0.1
      },
      "gradient_accumulation_steps": 4
    },
    "data": {
      "use_json_format": true,
      "train_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/caption_breast/caption_breast_train.json",
      "valid_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/caption_breast/caption_breast_valid.json",
      "test_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/caption_breast/caption_breast_test.json",
      "image_root": "/media/ps/data/Datasets/ultrasound",
      "image_size": 384,
      "max_text_length": 128,
      "tokenizer_type": "local_bert",
      "image_normalization": "clip",
      "ultrasound_augmentation": {
        "enabled": true,
        "contrast_enhancement": false,
        "noise_reduction": false,
        "edge_enhancement": false,
        "gamma_correction": [0.95, 1.05],
        "rotation_range": [-2, 2],
        "brightness_range": [0.95, 1.05],
        "contrast_range": [0.95, 1.05]
      },
      "num_workers": 4,
      "pin_memory": true,
      "prefetch_factor": 2
    }
  }
  