{
    "model": {
      "type": "qwen_vl_clip",
      "model_name": "qwen_vl_clip",
      "embed_dim": 768,
      "vision_encoder": {
        "model_path": "/media/ps/data-ssd/DolphinV1/dolphinV1_3B",
        "process_type": "attention_pooling",
        "vision_dim": 2048,
        "attention_heads": 8,
        "dropout": 0.1,
        "layer_norm_eps": 1e-6
      },
      "text_encoder": {
        "model_name": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/BiomedBERT/BiomedNLP-BiomedBERT-base-uncased-abstract",
        "max_length": 128,
        "dropout": 0.1
      },
      "device": "auto",
      "description": "简单高效损失函数测试版本 - CLIP + Hard Negative"
    },
    "training": {
      "batch_size": 16,
      "learning_rate": 5e-5,
      "weight_decay": 0.01,
      "max_epochs": 20,
      "early_stopping_patience": 8,
      "early_stopping_min_delta": 0.001,
      "gradient_clip_val": 0.5,
      "warmup_steps": 300,
      "val_check_interval": 0.25,
      "log_every_n_steps": 10,
      "save_top_k": 5,
      "monitor": "val_loss",
      "mode": "min",
      "optimizer": {
        "type": "adamw",
        "lr": 5e-5,
        "weight_decay": 0.01,
        "betas": [0.9, 0.95],
        "eps": 1e-6,
        "amsgrad": true
      },
      "scheduler": {
        "type": "cosine_with_warmup",
        "warmup_steps": 300,
        "max_steps": 8000,
        "eta_min": 5e-6,
        "warmup_init_lr": 5e-6
      },
      "loss": {
        "type": "ultrasound_simple",
        "temperature": 0.1,
        "label_smoothing": 0.1,
        "hard_negative_ratio": 0.3,
        "margin": 0.2,
        "use_soft_label": true,
        "soft_label_temp": 2.0,
        "soft_label_weight": 0.6
      },
      "gradient_accumulation_steps": 2,
      "mixed_precision": true,
      "find_unused_parameters": false,
      "numerical_stability": {
        "eps": 1e-6,
        "feature_enhancement_scale": 1.02,
        "gradient_clip_norm": 0.5,
        "nan_inf_detection": true,
        "safe_fallback": true
      }
    },
    "data": {
      "use_json_format": true,
      "train_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片/split_output/train.json",
      "valid_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片/split_output/val.json",
      "test_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片/split_output/test.json",
      "image_root": "/media/ps/data/Datasets/ultrasound",
      "image_size": 384,
      "max_text_length": 128,
      "tokenizer_type": "local_bert",
      "image_normalization": "clip",
      "ultrasound_augmentation": {
        "enabled": true,
        "contrast_enhancement": true,
        "noise_reduction": true,
        "edge_enhancement": true,
        "gamma_correction": [0.8, 1.2],
        "rotation_range": [-5, 5],
        "brightness_range": [0.9, 1.1],
        "contrast_range": [0.9, 1.1],
        "elastic_deformation": false,
        "cutout_probability": 0.1,
        "mixup_alpha": 0.2,
        "cutmix_alpha": 0.1,
        "random_erasing": 0.05,
        "gaussian_blur": 0.05,
        "speckle_noise": 0.02,
        "motion_blur": 0.02
      },
      "batch_size": 16,
      "num_workers": 12,
      "pin_memory": true,
      "prefetch_factor": 4
    },
    "validation": {
      "checkpoint_every_n_epochs": 2,
      "validate_every_n_steps": 100,
      "save_best_model": true,
      "metric_for_best_model": "val_accuracy",
      "greater_is_better": true
    },
    "logging": {
      "log_level": "INFO",
      "log_nan_inf_warnings": true,
      "track_numerical_stability": true,
      "save_training_curves": true,
      "wandb_project": "ultrasound-clip-optimized",
      "experiment_name": "qwen_vl_clip_simple_loss_test"
    },
    "version": "6.0-new_loss",
    "optimizations": [
      "简单高效的损失函数设计",
      "基础CLIP损失+标签平滑",
      "简单hard negative mining",
      "数值稳定性优先",
      "计算效率优化",
      "避免过度复杂化"
    ],
    "changelog": {
      "v6.0-new_loss": {
        "date": "2024-current",
        "changes": [
          "设计简单高效的ultrasound_simple损失函数",
          "基于CLIP损失+标签平滑+简单hard negative",
          "避免过度复杂的多组件设计",
          "专注于数值稳定性和训练效率",
          "降低计算开销，提高收敛速度",
          "保持池化策略不变以控制变量"
        ]
      }
    }
  }
