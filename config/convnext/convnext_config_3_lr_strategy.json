  "logging": {
    "log_level": "INFO",
    "log_nan_inf_warnings": true,
    "track_numerical_stability": true,
    "save_training_curves": true,
    "wandb_project": "ultrasound-clip-optimized",
    "experiment_name": "convnext_roberta_clip_lr_strategy"
  },
  "version": "3.0_lr_strategy",
  "experiment_description": "学习率策略优化实验：精细化学习率调度，平衡性能和稳定性",
  "optimizations": [
    "提升学习率：4e-5 → 5e-5",
    "延长warmup：1000 → 1500步",
    "更强beta2：0.95 → 0.98",
    "启用AMSGrad优化器",
