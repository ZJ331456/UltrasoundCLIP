{
  "model": {
    "type": "convnext_clip",
    "model_name": "convnext_roberta_clip",
    "embed_dim": 768,
    "vision_pooling": "auto",
    "vision_encoder": {
      "model_path": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/ConvNeXt/convnext-tiny-224",
      "vision_dim": 768
    },
    "text_encoder": {
      "model_name": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/RoBerta/roberta-base",
      "max_length": 128
    },
    "device": "auto",
    "description": "学习率策略优化实验：基于combined_best，精细化学习率调度"
  },
  "training": {
    "batch_size": 64,
    "learning_rate": 5e-5,
    "weight_decay": 0.025,
    "max_epochs": 200,
    "early_stopping_patience": 20,
    "early_stopping_min_delta": 0.0001,
    "gradient_clip_val": 1.2,
    "warmup_steps": 1500,
    "val_check_interval": 0.5,
    "log_every_n_steps": 10,
    "save_top_k": 3,
    "monitor": "val_r1",
    "mode": "max",
    "use_optimized_lr_strategy": true,
    "use_ema": true,
    "ema_config": {
      "enabled": true,
      "decay": 0.9996,
      "update_after_step": 150,
      "use_ema_for_validation": true,
      "use_ema_for_best_model": true,
      "warmup_steps": 1800,
      "decay_warmup": true
    },
    "optimizer": {
      "type": "adamw_optimized",
      "lr": 5e-5,
      "weight_decay": 0.025,
      "betas": [0.9, 0.98],
      "eps": 1e-8,
      "amsgrad": true,
      "layerwise_lr_decay": true,
      "layer_decay_rate": 0.92,
      "exclude_bias_norm_from_decay": true,
      "differential_lr": {
        "enabled": true,
        "vision_lr_scale": 0.5,
        "text_lr_scale": 1.0,
        "projection_lr_scale": 2.0
      }
    },
    "scheduler": {
      "type": "cosine_with_linear_warmup",
      "warmup_steps": 1500,
      "max_steps": 10000,
      "eta_min": 8e-7,
      "warmup_init_lr": 8e-7,
      "restart_on_plateau": true,
      "plateau_patience": 4,
      "cooldown_factor": 0.7,
      "advanced_scheduling": {
        "enabled": true,
        "multi_step_milestones": [3000, 6000, 8500],
        "multi_step_gamma": 0.8,
        "exponential_decay_rate": 0.95,
        "min_lr_threshold": 5e-7
      }
    },
    "loss": {
      "type": "simplified_clip_stable",
      "use_optimized_loss": true,
      "temperature": 0.06,
      "label_smoothing": 0.12,
      "numerical_stability": {
        "feature_clamp_range": [-10.0, 10.0],
        "similarity_clamp_range": [-50.0, 50.0],
        "safe_normalize_eps": 1e-8,
        "gradient_clip_loss": true
      },
      "adaptive_temperature": {
        "enabled": true,
        "min_temp": 0.04,
        "max_temp": 0.1,
        "adaptation_rate": 0.01
      }
    },
    "gradient_accumulation_steps": 4,
    "mixed_precision": true,
    "find_unused_parameters": false,
    "lora": {
      "enabled": false
    },
    "advanced_training": {
      "gradient_centralization": true,
      "sam_optimizer": false,
      "lookahead": false,
      "learning_rate_finder": false
    }
  },
  "data": {
    "use_json_format": true,
    "train_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/train.json",
    "valid_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/val.json",
    "test_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/test.json",
    "image_root": "/media/ps/data/Datasets/ultrasound",
    "image_size": 384,
    "max_text_length": 128,
    "tokenizer_type": "local_bert",
    "image_normalization": "clip",
    "use_optimized_augmentation": true,
    "ultrasound_optimization": {
      "enabled": true,
      "target_image_size": 384,
      "preserve_aspect_ratio": true,
      "fill_color": [128, 128, 128],
      "augmentation": {
        "enabled": true,
        "use_medical_safe_augmentation": true,
        "rotation_range": 2,
        "brightness_range": 0.05,
        "contrast_range": 0.05,
        "gamma_correction": true,
        "speckle_noise": false,
        "preserve_medical_structures": true
      },
      "preprocessing": {
        "force_rgb": true,
        "normalize": true,
        "mean": [0.485, 0.456, 0.406],
        "std": [0.229, 0.224, 0.225],
        "use_imagenet_normalization": true
      }
    },
    "ultrasound_augmentation": {
      "enabled": true,
      "use_medical_optimized": true,
      "contrast_enhancement": false,
      "noise_reduction": false,
      "edge_enhancement": false,
