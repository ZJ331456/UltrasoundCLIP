      "preprocessing": {
        "force_rgb": true,
        "normalize": true,
        "mean": [0.5, 0.5, 0.5],
        "std": [0.5, 0.5, 0.5]
      }
    },
    "ultrasound_augmentation": {
      "enabled": true,
      "contrast_enhancement": false,
      "noise_reduction": false,
      "edge_enhancement": false,
      "gamma_correction": [0.9, 1.1],
      "rotation_range": [-3, 3],
      "brightness_range": [0.9, 1.1],
      "contrast_range": [0.9, 1.1],
      "elastic_deformation": false,
      "cutout_probability": 0.05,
      "mixup_alpha": 0.0,
      "cutmix_alpha": 0.0,
      "random_erasing": 0.02,
      "gaussian_blur": 0.01,
      "speckle_noise": 0.005,
      "motion_blur": 0.005
