{
  "model": {
    "type": "convnext_clip",
    "model_name": "convnext_roberta_clip",
    "embed_dim": 768,
    "vision_pooling": "auto",
    "vision_encoder": {
      "model_path": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/ConvNeXt/convnext-tiny-224",
      "vision_dim": 768
    },
    "text_encoder": {
      "model_name": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/RoBerta/roberta-base",
      "max_length": 128
    },
    "device": "auto",
    "description": "学习率优化 + 正则化策略 - 解决过拟合问题"
  },
  "training": {
    "batch_size": 64,
    "learning_rate": 3e-5,
    "weight_decay": 0.05,
    "max_epochs": 200,
    "early_stopping_patience": 15,
    "early_stopping_min_delta": 0.001,
    "gradient_clip_val": 0.8,
    "warmup_steps": 1500,
    "val_check_interval": 0.25,
    "log_every_n_steps": 10,
    "save_top_k": 3,
    "monitor": "val_r1",
    "mode": "max",
    "use_optimized_lr_strategy": true,
    "optimizer": {
      "type": "adamw_optimized",
      "lr": 3e-5,
      "weight_decay": 0.05,
      "betas": [0.9, 0.95],
      "eps": 1e-8,
      "amsgrad": false,
      "layerwise_lr_decay": true,
      "layer_decay_rate": 0.9,
      "exclude_bias_norm_from_decay": true
    },
    "scheduler": {
      "type": "cosine_with_linear_warmup",
      "warmup_steps": 1500,
      "max_steps": 10000,
      "eta_min": 5e-7,
      "warmup_init_lr": 5e-7,
      "restart_on_plateau": true,
      "plateau_patience": 8,
      "cooldown_factor": 0.3
    },
    "loss": {
      "type": "ultrasound_finegrained",
      "temperature": 0.1,
      "margin": 0.2,
      "hard_ratio": 0.2,
      "focal_gamma": 1.0,
      "similarity_threshold": 0.7,
      "contrastive_scale": 1.0,
      "dynamic_temp_target": 0.5,
      "dynamic_temp_gain": 1.5,
      "semi_hard_window": 0.03,
      "loss_weights": {
        "clip": 1.0,
        "hard_neg": 0.3,
        "triplet": 0.15,
        "focal": 0.1
      },
      "label_smoothing": 0.3,
      "feature_clamp_range": [-2.5, 2.5],
      "temperature_range": [0.05, 0.15]
    },
    "gradient_accumulation_steps": 4,
    "mixed_precision": true,
    "find_unused_parameters": false,
    "lora": {
      "enabled": false
    },
    "numerical_stability": {
      "eps": 1e-6,
      "feature_enhancement_scale": 1.01,
      "gradient_clip_norm": 0.8,
      "nan_inf_detection": true,
      "safe_fallback": true
    },
    "regularization": {
      "dropout_rate": 0.2,
      "layer_dropout": 0.1,
      "attention_dropout": 0.15
    }
  },
  "data": {
    "use_json_format": true,
