{
  "model": {
    "type": "convnext_clip",
    "model_name": "convnext_roberta_clip",
    "embed_dim": 768,
    "vision_pooling": "auto",
    "vision_encoder": {
      "model_path": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/ConvNeXt/convnext-tiny-224",
      "vision_dim": 768,
      "multi_scale_features": true,
      "feature_pyramid": {
        "enabled": true,
        "levels": [2, 3, 4],
        "fusion_method": "weighted_sum",
        "fusion_weights": [0.3, 0.4, 0.3]
      },
      "attention_pooling": {
        "enabled": true,
        "num_heads": 8,
        "hidden_dim": 768
      }
    },
    "text_encoder": {
      "model_name": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/RoBerta/roberta-base",
      "max_length": 128
    },
    "cross_modal_fusion": {
      "enabled": true,
      "fusion_layers": 2,
      "attention_type": "cross_attention",
      "num_heads": 12
    },
    "device": "auto",
    "description": "多尺度特征提取 + 跨模态融合优化实验"
  },
  "training": {
    "batch_size": 64,
    "learning_rate": 3e-5,
    "weight_decay": 0.025,
    "max_epochs": 200,
    "early_stopping_patience": 20,
    "early_stopping_min_delta": 0.0001,
    "gradient_clip_val": 0.25,
    "warmup_steps": 600,
    "val_check_interval": 0.5,
    "log_every_n_steps": 10,
    "save_top_k": 3,
    "monitor": "val_r1",
    "mode": "max",
    "optimizer": {
      "type": "adamw",
      "lr": 3e-5,
      "weight_decay": 0.025,
      "betas": [0.9, 0.999],
      "eps": 1e-8,
      "amsgrad": true
    },
    "scheduler": {
      "type": "cosine_with_warmup",
      "warmup_steps": 600,
      "max_steps": 6000,
      "eta_min": 5e-7,
      "warmup_init_lr": 5e-7
    },
    "loss": {
      "type": "ultrasound_finegrained",
      "temperature": 0.1,
      "margin": 0.2,
      "hard_ratio": 0.2,
      "focal_gamma": 1.0,
      "similarity_threshold": 0.7,
      "contrastive_scale": 1.0,
      "dynamic_temp_target": 0.5,
      "dynamic_temp_gain": 1.5,
      "semi_hard_window": 0.03,
      "loss_weights": {
        "clip": 1.0,
        "hard_neg": 0.3,
        "triplet": 0.15,
        "focal": 0.1
      },
      "label_smoothing": 0.2,
      "feature_clamp_range": [-2.5, 2.5],
      "temperature_range": [0.05, 0.15],
      "multi_scale_loss": {
        "enabled": true,
        "pyramid_levels": [2, 3, 4],
        "level_weights": [0.3, 0.4, 0.3]
      }
    },
    "gradient_accumulation_steps": 4,
    "mixed_precision": true,
    "find_unused_parameters": false,
    "lora": {
      "enabled": false
    },
    "numerical_stability": {
      "eps": 1e-6,
      "feature_enhancement_scale": 1.01,
      "gradient_clip_norm": 0.25,
      "nan_inf_detection": true,
      "safe_fallback": true
    }
  },
  "data": {
    "use_json_format": true,
    "train_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/train.json",
    "valid_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/val.json",
    "test_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/test.json",
    "image_root": "/media/ps/data/Datasets/ultrasound",
    "image_size": 384,
    "max_text_length": 128,
    "tokenizer_type": "local_bert",
    "image_normalization": "clip",
    "multi_scale_training": {
      "enabled": true,
      "scales": [320, 384, 448],
      "scale_probability": [0.2, 0.6, 0.2],
      "random_scale_per_epoch": true
    },
    "ultrasound_optimization": {
      "enabled": true,
      "target_image_size": 384,
      "preserve_aspect_ratio": true,
      "fill_color": [128, 128, 128],
      "augmentation": {
        "enabled": true,
        "rotation_range": 2,
        "brightness_range": 0.03,
        "contrast_range": 0.03,
        "gamma_correction": true,
        "speckle_noise": false,
        "multi_scale_aware": true
      },
      "preprocessing": {
        "force_rgb": true,
        "normalize": true,
        "mean": [0.5, 0.5, 0.5],
        "std": [0.5, 0.5, 0.5]
      }
    },
    "ultrasound_augmentation": {
      "enabled": true,
      "contrast_enhancement": false,
      "noise_reduction": false,
      "edge_enhancement": false,
      "gamma_correction": [0.97, 1.03],
      "rotation_range": [-1, 1],
      "brightness_range": [0.99, 1.01],
      "contrast_range": [0.99, 1.01],
      "elastic_deformation": false,
      "cutout_probability": 0.01,
      "mixup_alpha": 0.02,
      "cutmix_alpha": 0.01,
      "random_erasing": 0.005,
      "gaussian_blur": 0.005,
      "speckle_noise": 0.002,
      "motion_blur": 0.002,
      "scale_aware_augmentation": {
        "enabled": true,
        "adapt_to_scale": true
      }
    },
    "batch_size": 64,
    "num_workers": 8,
    "pin_memory": true,
    "prefetch_factor": 2
  },
  "validation": {
    "checkpoint_every_n_epochs": 1,
    "validate_every_n_steps": 150,
    "save_best_model": true,
    "metric_for_best_model": "val_r1",
    "greater_is_better": true,
    "multi_scale_validation": {
      "enabled": true,
      "test_scales": [320, 384, 448],
      "ensemble_results": true
    }
  },
  "logging": {
    "log_level": "INFO",
    "log_nan_inf_warnings": true,
    "track_numerical_stability": true,
    "save_training_curves": true,
    "wandb_project": "ultrasound-clip-optimized",
    "experiment_name": "convnext_roberta_clip_multi_scale"
  },
  "version": "2.0_multi_scale",
  "experiment_description": "多尺度特征提取实验：特征金字塔 + 注意力池化 + 跨模态融合",
  "optimizations": [
    "多尺度特征提取：启用特征金字塔网络，levels=[2,3,4]",
    "注意力池化：8头注意力机制替代全局平均池化",
    "跨模态融合：2层交叉注意力机制",
    "多尺度训练：320/384/448三种输入尺寸",
    "多尺度验证：集成多尺度预测结果",
    "尺度感知增强：根据输入尺寸自适应调整增强强度",
    "批次大小调整：48 (相比64减少以适应更复杂的模型)"
  ]
}
