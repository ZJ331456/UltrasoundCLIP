{
  "model": {
    "type": "convnext_clip",
    "model_name": "convnext_roberta_clip",
    "embed_dim": 768,
    "vision_pooling": "auto",
    "vision_encoder": {
      "model_path": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/ConvNeXt/convnext-tiny-224",
      "vision_dim": 768
    },
    "text_encoder": {
      "model_name": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/RoBerta/roberta-base",
      "max_length": 128
    },
    "device": "auto",
    "description": "高级损失函数实验：多尺度+自适应温度+语义一致性"
  },
  "training": {
    "batch_size": 64,
    "learning_rate": 3e-5,
    "weight_decay": 0.025,
    "max_epochs": 200,
    "early_stopping_patience": 20,
    "early_stopping_min_delta": 0.0001,
    "gradient_clip_val": 0.25,
    "warmup_steps": 600,
    "val_check_interval": 0.5,
    "log_every_n_steps": 10,
    "save_top_k": 3,
    "monitor": "val_r1",
    "mode": "max",
    "optimizer": {
      "type": "adamw",
      "lr": 3e-5,
      "weight_decay": 0.025,
      "betas": [0.9, 0.999],
      "eps": 1e-8,
      "amsgrad": true
    },
    "scheduler": {
      "type": "cosine_with_warmup",
      "warmup_steps": 600,
      "max_steps": 6000,
      "eta_min": 5e-7,
      "warmup_init_lr": 5e-7
    },
    "loss": {
      "type": "ultrasound_advanced",
      "temperature": 0.07,
      "use_adaptive_temperature": true,
      "adaptive_temp_config": {
        "min_temp": 0.05,
        "max_temp": 0.12,
        "adaptation_rate": 0.05
      },
      "hard_negative_mining": {
        "enabled": true,
        "ratio": 0.4,
        "margin": 0.3,
        "semi_hard_ratio": 0.6
      },
      "multi_scale_loss": {
        "enabled": true,
        "scales": [0.5, 0.75, 1.0],
        "weights": [0.2, 0.3, 0.5],
        "scale_method": "interpolation"
      },
      "semantic_consistency": {
        "enabled": true,
        "weight": 0.05,
        "consistency_type": "cross_modal"
      },
      "feature_diversity": {
        "enabled": true,
        "diversity_weight": 0.05,
        "regularization_strength": 0.05
      },
      "label_smoothing": 0.2,
      "numerical_stability": {
        "feature_clamp_range": [-5.0, 5.0],
        "similarity_clamp_range": [-20.0, 20.0],
        "safe_normalize_eps": 1e-8
      }
    },
    "gradient_accumulation_steps": 4,
    "mixed_precision": true,
    "find_unused_parameters": false,
    "lora": {
      "enabled": false
    },
    "numerical_stability": {
      "eps": 1e-6,
      "feature_enhancement_scale": 1.01,
      "gradient_clip_norm": 0.25,
      "nan_inf_detection": true,
      "safe_fallback": true
    }
  },
  "data": {
    "use_json_format": true,
    "train_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/train.json",
    "valid_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/val.json",
    "test_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/test.json",
    "image_root": "/media/ps/data/Datasets/ultrasound",
    "image_size": 384,
    "max_text_length": 128,
    "tokenizer_type": "local_bert",
    "image_normalization": "clip",
    "ultrasound_optimization": {
      "enabled": true,
      "target_image_size": 384,
      "preserve_aspect_ratio": true,
      "fill_color": [128, 128, 128],
      "multi_scale_training": {
        "enabled": true,
        "scales": [320, 384, 448],
        "scale_probability": [0.3, 0.4, 0.3]
      },
      "augmentation": {
        "enabled": true,
        "rotation_range": 2,
        "brightness_range": 0.03,
        "contrast_range": 0.03,
        "gamma_correction": true,
        "speckle_noise": false
      },
      "preprocessing": {
        "force_rgb": true,
        "normalize": true,
        "mean": [0.5, 0.5, 0.5],
        "std": [0.5, 0.5, 0.5]
      }
    },
    "ultrasound_augmentation": {
      "enabled": true,
      "contrast_enhancement": false,
      "noise_reduction": false,
      "edge_enhancement": false,
      "gamma_correction": [0.97, 1.03],
      "rotation_range": [-1, 1],
      "brightness_range": [0.99, 1.01],
      "contrast_range": [0.99, 1.01],
      "elastic_deformation": false,
      "cutout_probability": 0.01,
      "mixup_alpha": 0.02,
      "cutmix_alpha": 0.01,
      "random_erasing": 0.005,
      "gaussian_blur": 0.005,
      "speckle_noise": 0.002,
      "motion_blur": 0.002
    },
    "batch_size": 64,
    "num_workers": 8,
    "pin_memory": true,
    "prefetch_factor": 2
  },
  "validation": {
    "checkpoint_every_n_epochs": 1,
    "validate_every_n_steps": 150,
    "save_best_model": true,
    "metric_for_best_model": "val_r1",
    "greater_is_better": true
  },
  "logging": {
    "log_level": "INFO",
    "log_nan_inf_warnings": true,
    "track_numerical_stability": true,
    "save_training_curves": true,
    "wandb_project": "ultrasound-clip-optimized",
    "experiment_name": "convnext_roberta_clip_advanced_loss"
  },
  "version": "2.0_advanced",
  "experiment_description": "高级损失函数实验：自适应温度 + 多尺度 + 语义一致性 + 特征多样性",
  "optimizations": [
    "自适应温度：根据训练进度动态调整温度参数",
    "多尺度损失：在不同尺度上计算损失，增强尺度不变性",
    "语义一致性：确保跨模态特征的语义对齐",
    "特征多样性：防止特征坍塌，增强表示能力",
    "增强硬负样本挖掘：ratio=0.4，semi_hard_ratio=0.6",
    "多尺度训练：支持320/384/448三种输入尺寸"
  ]
}
