{
  "model": {
    "type": "convnext_clip",
    "model_name": "convnext_roberta_clip",
    "embed_dim": 768,
    "vision_pooling": "auto",
    "vision_encoder": {
      "model_path": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/ConvNeXt/convnext-tiny-224",
      "vision_dim": 768
    },
    "text_encoder": {
      "model_name": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/RoBerta/roberta-base",
      "max_length": 128
    },
    "device": "auto",
    "description": "过拟合缓解实验：基于combined_best，强化正则化和Dropout"
  },
  "training": {
    "batch_size": 64,
    "learning_rate": 3e-5,
    "weight_decay": 0.05,
    "max_epochs": 200,
    "early_stopping_patience": 15,
    "early_stopping_min_delta": 0.0001,
    "gradient_clip_val": 0.8,
    "warmup_steps": 1200,
    "val_check_interval": 0.25,
    "log_every_n_steps": 10,
    "save_top_k": 3,
    "monitor": "val_r1",
    "mode": "max",
    "use_optimized_lr_strategy": true,
    "use_ema": true,
    "ema_config": {
      "enabled": true,
      "decay": 0.9998,
      "update_after_step": 100,
      "use_ema_for_validation": true,
      "use_ema_for_best_model": true,
      "warmup_steps": 1200,
      "decay_warmup": true
    },
    "optimizer": {
      "type": "adamw_optimized",
      "lr": 3e-5,
      "weight_decay": 0.05,
      "betas": [0.9, 0.95],
      "eps": 1e-8,
      "amsgrad": false,
      "layerwise_lr_decay": true,
      "layer_decay_rate": 0.9,
      "exclude_bias_norm_from_decay": true
    },
    "scheduler": {
      "type": "cosine_with_linear_warmup",
      "warmup_steps": 1200,
      "max_steps": 8000,
      "eta_min": 5e-7,
      "warmup_init_lr": 5e-7,
      "restart_on_plateau": true,
      "plateau_patience": 8,
      "cooldown_factor": 0.6
    },
    "loss": {
      "type": "simplified_clip_stable",
      "use_optimized_loss": true,
      "temperature": 0.08,
      "label_smoothing": 0.15,
      "numerical_stability": {
        "feature_clamp_range": [-8.0, 8.0],
        "similarity_clamp_range": [-40.0, 40.0],
        "safe_normalize_eps": 1e-8,
        "gradient_clip_loss": true
      },
      "regularization": {
        "dropout_rate": 0.15,
        "feature_dropout": 0.1,
        "projection_dropout": 0.2
      }
    },
    "gradient_accumulation_steps": 6,
    "mixed_precision": true,
    "find_unused_parameters": false,
    "lora": {
      "enabled": false
    },
    "regularization": {
      "dropout_enhanced": true,
      "stochastic_depth": 0.1,
      "feature_noise_std": 0.05,
      "gradient_penalty_weight": 0.01
    }
  },
  "data": {
    "use_json_format": true,
    "train_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/train.json",
    "valid_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/val.json",
    "test_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片2/split_output/test.json",
    "image_root": "/media/ps/data/Datasets/ultrasound",
    "image_size": 384,
    "max_text_length": 128,
    "tokenizer_type": "local_bert",
    "image_normalization": "clip",
    "use_optimized_augmentation": true,
    "ultrasound_optimization": {
      "enabled": true,
      "target_image_size": 384,
      "preserve_aspect_ratio": true,
      "fill_color": [128, 128, 128],
      "augmentation": {
        "enabled": true,
        "use_medical_safe_augmentation": true,
        "rotation_range": 3,
        "brightness_range": 0.08,
        "contrast_range": 0.08,
        "gamma_correction": true,
        "speckle_noise": false,
        "preserve_medical_structures": true
      },
      "preprocessing": {
        "force_rgb": true,
        "normalize": true,
        "mean": [0.485, 0.456, 0.406],
        "std": [0.229, 0.224, 0.225],
        "use_imagenet_normalization": true
      }
    },
    "ultrasound_augmentation": {
      "enabled": true,
      "use_medical_optimized": true,
      "contrast_enhancement": false,
      "noise_reduction": false,
      "edge_enhancement": false,
      "gamma_correction": [0.9, 1.1],
      "rotation_range": [-3, 3],
      "brightness_range": [0.92, 1.08],
      "contrast_range": [0.92, 1.08],
      "elastic_deformation": false,
      "cutout_probability": 0.1,
      "mixup_alpha": 0.2,
      "cutmix_alpha": 0.0,
      "random_erasing": 0.1,
      "gaussian_blur": 0.05,
      "speckle_noise": 0.0,
      "motion_blur": 0.0,
      "safe_augmentation_policy": {
        "no_horizontal_flip": true,
        "preserve_anatomy": true,
        "max_rotation_degrees": 3,
        "color_jitter_strength": 0.08
      }
    },
    "batch_size": 64,
    "num_workers": 8,
    "pin_memory": true,
    "prefetch_factor": 2
  },
  "validation": {
    "checkpoint_every_n_epochs": 1,
    "validate_every_n_steps": 100,
    "save_best_model": true,
    "metric_for_best_model": "val_r1",
    "greater_is_better": true
  },
  "logging": {
    "log_level": "INFO",
    "log_nan_inf_warnings": true,
    "track_numerical_stability": true,
    "save_training_curves": true,
    "wandb_project": "ultrasound-clip-optimized",
    "experiment_name": "convnext_roberta_clip_overfitting_fix"
  },
  "version": "3.0_overfitting_fix",
  "experiment_description": "过拟合缓解实验：强化正则化、增强数据增强、更保守的学习率策略",
  "optimizations": [
    "降低学习率：4e-5 → 3e-5",
    "增强权重衰减：0.02 → 0.05",
    "增强标签平滑：0.1 → 0.15",
    "增加数据增强：cutout、mixup、random_erasing",
    "更强层衰减：0.95 → 0.9",
    "更频繁验证：0.5 → 0.25 epoch",
    "增强Dropout和特征噪声"
  ]
}
