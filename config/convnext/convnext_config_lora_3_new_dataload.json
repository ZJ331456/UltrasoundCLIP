{
    "model": {
      "type": "convnext_clip",
      "model_name": "convnext_roberta_clip",
      "embed_dim": 768,
      "vision_pooling": "auto",
      "vision_encoder": {
        "model_path": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/ConvNeXt/convnext-tiny-224",
        "vision_dim": 768
      },
      "text_encoder": {
        "model_name": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/RoBerta/roberta-base",
        "max_length": 128
      },
      "device": "auto",
      "description": "ConvNeXt(图像)+RoBERTa(文本) 的 CLIP 轻量模型 - LoRA优化版 + 超声图像优化"
    },
    "training": {
      "batch_size": 32,
      "learning_rate": 8e-5,
      "weight_decay": 0.005,
      "max_epochs": 100,
      "early_stopping_patience": 12,
      "early_stopping_min_delta": 0.0005,
      "gradient_clip_val": 0.5,
      "warmup_steps": 400,
      "val_check_interval": 0.4,
      "log_every_n_steps": 10,
      "save_top_k": 5,
      "monitor": "val_r1",
      "mode": "max",
      "optimizer": {
        "type": "adamw",
        "lr": 8e-5,
        "weight_decay": 0.005,
        "betas": [0.9, 0.999],
        "eps": 1e-8,
        "amsgrad": true
      },
      "lora": {
        "enabled": true,
        "r": 16,
        "alpha": 32,
        "dropout": 0.05,
        "bias": "lora_only",
        "task_type": "FEATURE_EXTRACTION",
        "target_modules": ["query", "key", "value", "dense"]
      },
      "scheduler": {
        "type": "cosine_with_warmup",
        "warmup_steps": 600,
        "max_steps": 10000,
        "eta_min": 1e-6,
        "warmup_init_lr": 1e-6
      },
      "loss": {
        "type": "ultrasound_finegrained",
        "temperature": 0.05,
        "margin": 0.25,
        "hard_ratio": 0.4,
        "focal_gamma": 1.5,
        "similarity_threshold": 0.8,
        "contrastive_scale": 1.5,
        "dynamic_temp_target": 0.6,
        "dynamic_temp_gain": 2.0,
        "semi_hard_window": 0.05,
        "loss_weights": {
          "clip": 1.0,
          "hard_neg": 0.7,
          "triplet": 0.4,
          "focal": 0.25
        },
        "label_smoothing": 0.1,
        "feature_clamp_range": [-5.0, 5.0],
        "temperature_range": [0.02, 0.2]
      },
      "gradient_accumulation_steps": 1,
      "mixed_precision": true,
      "find_unused_parameters": false,
      "numerical_stability": {
        "eps": 1e-6,
        "feature_enhancement_scale": 1.02,
        "gradient_clip_norm": 0.5,
        "nan_inf_detection": true,
        "safe_fallback": true
      }
    },
    "data": {
      "use_json_format": true,
      "train_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片/split_output/train.json",
      "valid_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片/split_output/val.json",
      "test_json": "/media/ps/data-ssd/UltrasoundRAG/clip_caption/data-anatomy/更新路径之后的json数据集/split_with_llm_enhance_refined/筛选图片/split_output/test.json",
      "image_root": "/media/ps/data/Datasets/ultrasound",
      "image_size": 384,
      "max_text_length": 128,
      "tokenizer_type": "local_bert",
      "image_normalization": "clip",
      "ultrasound_optimization": {
        "enabled": true,
        "target_image_size": 384,
        "preserve_aspect_ratio": true,
        "fill_color": [128, 128, 128],
        "augmentation": {
          "enabled": true,
          "rotation_range": 5,
          "brightness_range": 0.1,
          "contrast_range": 0.1,
          "gamma_correction": true,
          "speckle_noise": true
        },
        "preprocessing": {
          "force_rgb": true,
          "normalize": true,
          "mean": [0.5, 0.5, 0.5],
          "std": [0.5, 0.5, 0.5]
        }
      },
      "ultrasound_augmentation": {
        "enabled": true,
        "contrast_enhancement": true,
        "noise_reduction": true,
        "edge_enhancement": true,
        "gamma_correction": [0.9, 1.1],
        "rotation_range": [-3, 3],
        "brightness_range": [0.95, 1.05],
        "contrast_range": [0.95, 1.05],
        "elastic_deformation": false,
        "cutout_probability": 0.06,
        "mixup_alpha": 0.15,
        "cutmix_alpha": 0.08,
        "random_erasing": 0.03,
        "gaussian_blur": 0.03,
        "speckle_noise": 0.015,
        "motion_blur": 0.015
      },
      "batch_size": 20,
      "num_workers": 12,
      "pin_memory": true,
      "prefetch_factor": 4
    },
    "validation": {
      "checkpoint_every_n_epochs": 2,
      "validate_every_n_steps": 100,
      "save_best_model": true,
      "metric_for_best_model": "val_accuracy",
      "greater_is_better": true
    },
    "logging": {
      "log_level": "INFO",
      "log_nan_inf_warnings": true,
      "track_numerical_stability": true,
      "save_training_curves": true,
      "wandb_project": "ultrasound-clip-optimized",
      "experiment_name": "convnext_roberta_clip_lora_v3_new_dataload"
    },
    "version": "3.0",
    "optimizations": [
        "LoRA参数优化：r=16, alpha=32",
        "学习率提升：8e-5，权重衰减降低：0.005",
        "目标模块扩展：增加intermediate和output",
        "损失权重调整：增强困难样本学习",
        "数据增强收紧：减少过度增强",
        "早停策略优化：patience=12, min_delta=0.0005",
        "批次大小优化：20，梯度累积：1",
        "温度参数优化：0.05，增强对比学习",
        "新增：启用超声图像优化数据集",
        "新增：等比例缩放+填充预处理",
        "新增：超声图像特定数据增强",
        "新增：与现有ultrasound_augmentation兼容"
    ]
  }
