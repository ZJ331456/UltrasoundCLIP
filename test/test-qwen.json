{
  "model": {
    "type": "qwen_vl_clip",
    "model_name": "qwen_vl_clip",
    "embed_dim": 512,
    "vision_encoder": {
      "model_path": "/media/ps/data-ssd/DolphinV1/dolphinV1_3B",
      "process_type": "default",
      "vision_dim": 2048,
      "attention_heads": 8,
      "dropout": 0.1,
      "layer_norm_eps": 1e-6
    },
    "text_encoder": {
      "model_name": "/media/ps/data-ssd/UltrasoundRAG/CLIP/checkpoints/BiomedBERT/BiomedNLP-BiomedBERT-base-uncased-abstract",
      "max_length": 128,
      "dropout": 0.1
    },
    "device": "auto",
    "description": "优化的Qwen2.5-VL CLIP模型配置，针对超声图片训练"
  },
  "training": {
    "batch_size": 16,
    "learning_rate": 5e-5,
    "weight_decay": 0.01,
    "max_epochs": 15,
    "early_stopping_patience": 12,
    "gradient_clip_val": 1.0,
    "warmup_steps": 500,
    "val_check_interval": 0.25,
    "log_every_n_steps": 20,
    "save_top_k": 3,
    "monitor": "val_loss",
    "mode": "min",
    "optimizer": {
      "type": "adamw",
      "lr": 5e-5,
      "weight_decay": 0.01,
      "betas": [0.9, 0.98],
      "eps": 1e-8
    },
    "scheduler": {
      "type": "cosine_with_warmup",
      "warmup_steps": 500,
      "max_steps": 10000,
      "eta_min": 1e-7
    },
    "loss": {
      "type": "clip",
      "temperature": 0.1,
      "label_smoothing": 0.05
    },
    "gradient_accumulation_steps": 8
  },
  "data": {
    "use_json_format": true,
    "train_json": "/media/ps/data-ssd/UltrasoundRAG/CLIP/test/demo-train.json",
    "valid_json": "/media/ps/data-ssd/UltrasoundRAG/CLIP/test/demo-val.json",
    "test_json": "/media/ps/data-ssd/UltrasoundRAG/CLIP/test/demo-test.json",
    "image_root": "/media/ps/data/Datasets/ultrasound",
    "image_size": 588,
    "max_text_length": 256,
    "tokenizer_type": "local_bert",
    "image_normalization": "imagenet",
    "ultrasound_augmentation": {
      "enabled": true,
      "contrast_enhancement": true,
      "noise_reduction": true,
      "edge_enhancement": true,
      "gamma_correction": [0.8, 1.2],
      "rotation_range": [-3, 3],
      "brightness_range": [0.9, 1.1],
      "contrast_range": [0.9, 1.1]
    },
    "num_workers": 4,
    "pin_memory": true,
    "prefetch_factor": 2
  }
}
